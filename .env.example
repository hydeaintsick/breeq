# MongoDB (Prisma) — Atlas or local
DATABASE_URL="mongodb://127.0.0.1:27017/breeq"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3333"
AUTH_TRUST_HOST="true"

# Optional: comma-separated emails that receive the ADMIN role on sign-in
ADMIN_EMAIL=""

# Optional "Continue with Google" (one button: creates the account on first use, signs in after).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# Google only accepts http:// on localhost — use http://localhost:3333 for dev,
# and an https:// public domain for production. Custom hosts like *.local are refused.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary — story episode backgrounds (folder: breeq/story-backgrounds)
# and player map skies for Earn (folder: breeq/earn-backgrounds)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe — the only payment rail. Gem packs are paid inside the shop sheet: a PaymentIntent
# confirmed by Stripe Elements (card, Apple Pay, Google Pay). Both keys are needed; without
# them the shop shows the prices and sells nothing.
# Dashboard → Developers → API keys (use the test keys locally).
# Webhook endpoint: {AUTH_URL}/api/stripe/webhook, event: payment_intent.succeeded
# (keep checkout.session.completed while old Checkout Sessions may still be paid).
# Locally: stripe listen --forward-to localhost:3333/api/stripe/webhook
# Apple Pay / Google Pay: register the domain once in Dashboard → Settings → Payment method
# domains; the file Apple checks is served from public/.well-known/.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional, dev only: credit gems without a card on the top-up page. Ignored in production.
EARN_SANDBOX="false"

# Android app (android/): SHA-256 of the certificates the app is signed with, comma-separated —
# the upload key printed by `pnpm android:release`, plus the Play app-signing key once published
# (Play Console → Setup → App signing). Served at /.well-known/assetlinks.json so breeq.space
# links open in the app. Empty: links stay in the browser.
ANDROID_CERT_SHA256=""
