generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  username       String?        @unique
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  passwordSetAt  DateTime?
  walletAddress  String?
  role           Role           @default(PLAYER)
  xp             Int            @default(0)
  /// When the player finished the how-to-play run. Null until then.
  tutorialDoneAt DateTime?
  /// Piece ids ("brick:explosive", "zone:portal", "rule:timer") the story has already explained once.
  discoveries    String[]       @default([])
  /// Earn: the gem balance (tickets and publishing are paid in gems).
  gems           Int            @default(0)
  /// Earn: the ETH balance in gwei (1 ETH = 1e9 gwei). Wins credit it; withdrawals debit it.
  ethGwei        BigInt         @default(0)
  /// Story: energy cells (`lib/energy.ts`). A run takes two, a clear gives one back, full at 00:00 UTC.
  energy         Int            @default(6)
  /// The UTC day (`YYYY-MM-DD`) the gauge was last settled on; `settleEnergy` recharges when it is not today.
  energyDay      String?
  /// The short code in this player's share links (`/r/<code>`). Minted the first time it is
  /// needed. Not `@unique`: Mongo would file every player without a code under one null key.
  /// `lib/referrals.ts` checks for a clash before writing.
  referralCode   String?
  /// Players who signed up through this player's link.
  referralsMade  Referral[]     @relation("referrer")
  /// The link this player signed up through, if any.
  referredBy     Referral?      @relation("referred")
  accounts       Account[]
  sessions       Session[]
  chapterClears  ChapterClear[]
  earnMaps       EarnMap[]
  earnRuns       EarnRun[]
  purchases      GemPurchase[]
  ledger         LedgerEntry[]
  withdrawals    Withdrawal[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([referralCode])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Episode {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String    @unique
  order         Int       @default(0)
  /// One line of story under the episode title on the shelf.
  tagline       String?
  backgroundUrl String?
  chapters      Chapter[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Chapter {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  episodeId String         @db.ObjectId
  episode   Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  order     Int            @default(0)
  xpReward  Int            @default(100)
  /// One or two sentences of story shown on the chapter card and before the run.
  intro     String?
  level     Json
  clears    ChapterClear[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([episodeId, slug])
}

/// One row, id "site": switches an admin flips for everyone.
model SiteSettings {
  id              String   @id @map("_id")
  /// Players go through the how-to-play run before the story opens.
  tutorialEnabled Boolean  @default(true)
  /// Earn is on the play menu and open to players who reach the unlock level.
  earnEnabled     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model ChapterClear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  chapterId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  /// Best star grade for this wall, 1–3. Replays keep the high water mark.
  stars     Int      @default(1)
  /// Paddle hits of the run that earned `stars`.
  hits      Int      @default(0)
  /// Board score of that run.
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
}

// -----------------------------------------------------------------------------
// Earn — player-built maps played for gems, cleared for ETH
// -----------------------------------------------------------------------------

/// One row, id "economy": the numbers an admin tunes. Defaults in `lib/economy.ts`.
model EconomySettings {
  id                String   @id @map("_id")
  /// USD price of one gem. Drives pack prices and the payout formula.
  gemPriceUsd       Float    @default(0.02)
  /// USD reference price of one ETH, for converting the USD payout into ETH.
  ethPriceUsd       Float    @default(3000)
  /// A win pays this multiple of the ticket's USD value. 1.5 = 150%.
  winMultiplier     Float    @default(1.5)
  /// Players can request a withdrawal once their ETH balance reaches this.
  withdrawMinEth    Float    @default(0.001)
  /// Gems charged to publish a map.
  publishCostGems   Int      @default(50)
  /// The ticket an author may set, in gems.
  ticketMinGems     Int      @default(20)
  ticketMaxGems     Int      @default(500)
  ticketDefaultGems Int      @default(100)
  /// Gem packs on the top-up page: `[{ gems, discountPct, tag }]`.
  packs             Json
  updatedAt         DateTime @updatedAt
}

enum EarnMapStatus {
  PUBLISHED
  HIDDEN
}

/// A player-built wall in the Earn store.
model EarnMap {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  authorId        String        @db.ObjectId
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  slug            String        @unique
  level           Json
  /// The author's photo (Cloudinary), or null when a gradient was picked.
  backgroundUrl   String?
  /// One of the twenty gradients in `lib/gradients.ts`, when no photo.
  gradientId      String?
  /// Gems a player pays to start a run.
  ticketGems      Int
  /// `rateDifficulty` at publish time: 0–100 and its tier label.
  difficulty      Int
  difficultyLabel String
  meanSeconds     Float?
  plays           Int           @default(0)
  wins            Int           @default(0)
  /// Admin pick for the top row of the store.
  featured        Boolean       @default(false)
  featuredOrder   Int           @default(0)
  status          EarnMapStatus @default(PUBLISHED)
  runs            EarnRun[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, plays, id])
  @@index([status, createdAt, id])
  @@index([status, difficulty, id])
  @@index([status, ticketGems, id])
  @@index([status, featured, featuredOrder])
  @@index([authorId])
}

enum EarnRunOutcome {
  OPEN
  WON
  LOST
}

/// One paid attempt at a map. The payout is locked in when the ticket is paid.
model EarnRun {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  userId     String         @db.ObjectId
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId      String         @db.ObjectId
  map        EarnMap        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  ticketGems Int
  outcome    EarnRunOutcome @default(OPEN)
  seed       Int
  score      Int            @default(0)
  /// What a win pays, in gwei, fixed at start.
  payoutGwei BigInt         @default(0)
  payoutUsd  Float          @default(0)
  createdAt  DateTime       @default(now())
  endedAt    DateTime?

  @@index([userId, mapId, outcome])
  @@index([userId, outcome])
  @@index([mapId])
  @@index([createdAt])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

/// A gem pack bought through Stripe. Credited once, when the PaymentIntent (the in-sheet
/// payment) or the Checkout Session (the earlier redirect flow) is paid — the gate is the
/// `PENDING → PAID` flip, not an index. The Stripe ids are plain indexes on purpose: a Mongo
/// unique index counts a missing field as `null`, and every purchase lacks one of the two.
model GemPurchase {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  userId                String         @db.ObjectId
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gems                  Int
  usdCents              Int
  discountPct           Float          @default(0)
  stripeSessionId       String?
  stripePaymentIntentId String?
  status                PurchaseStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  paidAt                DateTime?

  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum LedgerKind {
  TOPUP
  PUBLISH
  TICKET
  PAYOUT
  WITHDRAW
  WITHDRAW_REFUND
  GRANT
  /// Story: a chapter bought past instead of cleared.
  SKIP
  /// A friend signed up through the player's share link.
  REFERRAL
  /// Story: gems spent on an energy recharge.
  ENERGY
}

/// One sign-up through a share link. `referredId` is unique: an account is
/// referred once, whichever link it arrived by; creating the row is the gate
/// before the referrer is paid.
model Referral {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  referrerId String   @db.ObjectId
  referrer   User     @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String   @unique @db.ObjectId
  referred   User     @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)
  /// Gems paid to the referrer for this sign-up; 0 once their paid sign-ups are capped.
  gems       Int
  /// The share button the link came from ("x", "whatsapp", …), when known.
  via        String?
  createdAt  DateTime @default(now())

  @@index([referrerId, createdAt])
}

/// Every balance change, both currencies, signed. The wallet page reads it back.
model LedgerEntry {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      LedgerKind
  gems      Int        @default(0)
  ethGwei   BigInt     @default(0)
  /// Run, map, purchase or withdrawal id this entry belongs to.
  ref       String?
  note      String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

/// A player's request to receive ETH. Debited on request; refunded if rejected.
model Withdrawal {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  userId     String           @db.ObjectId
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountGwei BigInt
  toAddress  String
  status     WithdrawalStatus @default(PENDING)
  txHash     String?
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
