generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  username       String?        @unique
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  passwordSetAt  DateTime?
  walletAddress  String?
  role           Role           @default(PLAYER)
  xp             Int            @default(0)
  /// When the player finished the how-to-play run. Null until then.
  tutorialDoneAt DateTime?
  /// Piece ids ("brick:explosive", "zone:portal", "rule:timer") the story has already explained once.
  discoveries    String[]       @default([])
  accounts       Account[]
  sessions       Session[]
  chapterClears  ChapterClear[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Episode {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String    @unique
  order         Int       @default(0)
  /// One line of story under the episode title on the shelf.
  tagline       String?
  backgroundUrl String?
  chapters      Chapter[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Chapter {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  episodeId String         @db.ObjectId
  episode   Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  order     Int            @default(0)
  xpReward  Int            @default(100)
  /// One or two sentences of story shown on the chapter card and before the run.
  intro     String?
  level     Json
  clears    ChapterClear[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([episodeId, slug])
}

/// One row, id "site": switches an admin flips for everyone.
model SiteSettings {
  id              String   @id @map("_id")
  /// Players go through the how-to-play run before the story opens.
  tutorialEnabled Boolean  @default(true)
  /// Earn is on the play menu and open to players who reach the unlock level.
  earnEnabled     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model ChapterClear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  chapterId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  /// Best star grade for this wall, 1–3. Replays keep the high water mark.
  stars     Int      @default(1)
  /// Paddle hits of the run that earned `stars`.
  hits      Int      @default(0)
  /// Board score of that run.
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
}
